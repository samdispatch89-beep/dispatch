{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists()))"
      }
    },
    "companies": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "dispatchers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "drivers": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'dispatcher')"
    },
    "brokerages": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "loads": {
      "$loadId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'accountant' || root.child('users').child(auth.uid).child('role').val() === 'paperwork' || data.child('dispatcherId').val() === root.child('users').child(auth.uid).child('dispatcherId').val())",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'paperwork' || root.child('users').child(auth.uid).child('role').val() === 'accountant' || root.child('users').child(auth.uid).child('dispatcherId').val() === data.child('dispatcherId').val() || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'dispatcher' && newData.child('dispatcherId').val() === root.child('users').child(auth.uid).child('dispatcherId').val()))"
      }
    },
    "documents": {
      "$documentId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'accountant' || root.child('users').child(auth.uid).child('role').val() === 'paperwork' || root.child('users').child(auth.uid).child('dispatcherId').val() === data.child('dispatcherId').val())",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'paperwork' || root.child('users').child(auth.uid).child('role').val() === 'accountant')"
      }
    },
    "invoices": {
      "$invoiceId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'accountant')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'accountant')"
      }
    },
    "activity_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "notifications": {
      "$notificationId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === data.child('userId').val())",
        ".write": "auth != null"
      }
    },
    "weekly_summaries": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
