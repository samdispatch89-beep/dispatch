rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roleIs(expected) {
      return signedIn() && request.auth.token.role == expected;
    }

    function isAdmin() {
      return roleIs('admin');
    }

    function isAccountant() {
      return roleIs('accountant');
    }

    function isPaperwork() {
      return roleIs('paperwork');
    }

    function isDispatcher() {
      return roleIs('dispatcher');
    }

    match /loads/{loadId}/{docType}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /invoices/{year}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  },
  match /b/{bucket}/o {
    // This is like saying, "For my special toy box..."

    match /my-important-stuff/{fileId} {
      // ...and inside a special section called 'my-important-stuff',
      // for any toy (fileId) in there:

      allow read, write: if request.auth != null;
      // Allow people to read (look at) and write (put in/take out) toys,
      // BUT ONLY IF they are logged in (request.auth is not empty)!
    }

    // For everything else in the toy box, no one can touch it unless we say so!
  }
}

