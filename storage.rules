rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isAccountant() {
      return signedIn() && role() == 'accountant';
    }

    function isPaperwork() {
      return signedIn() && role() == 'paperwork';
    }

    function isDispatcher() {
      return signedIn() && role() == 'dispatcher';
    }

    match /companies/{companyName}/drivers/{driverName}/{yearWeek}/loads/{loadNumber}/{documentType}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || isPaperwork()
        || (isAccountant() && documentType == 'invoice')
        || (isDispatcher() && (documentType == 'rate_confirmation' || documentType == 'other'));
    }

    match /invoices/{companyName}/{yearWeek}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() || isAccountant();
    }
  }
}
